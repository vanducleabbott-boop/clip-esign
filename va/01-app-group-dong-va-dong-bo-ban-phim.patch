diff --git a/ClipKit/Extensions/Bundle+AppGroups.swift b/ClipKit/Extensions/Bundle+AppGroups.swift
index dfc85d7..aa8e85f 100644
--- a/ClipKit/Extensions/Bundle+AppGroups.swift
+++ b/ClipKit/Extensions/Bundle+AppGroups.swift
@@ -11,7 +11,57 @@ import Foundation
 public extension Bundle
 {
     var appGroups: [String] {
-        let appGroups = self.object(forInfoDictionaryKey: "ALTAppGroups") as? [String]
-        return appGroups ?? []
+        var candidates: [String] = []
+        
+        // 1. Doc com.apple.security.application-groups tu embedded.mobileprovision
+        func extractGroups(from url: URL) -> [String] {
+            guard let data = try? Data(contentsOf: url),
+                  let str = String(data: data, encoding: .isoLatin1),
+                  let start = str.range(of: "<?xml"),
+                  let end = str.range(of: "</plist>") else { return [] }
+            let plistStr = String(str[start.lowerBound...end.upperBound])
+            guard let plistData = plistStr.data(using: .utf8),
+                  let plist = try? PropertyListSerialization.propertyList(from: plistData, options: [], format: nil) as? [String: Any],
+                  let entitlements = plist["Entitlements"] as? [String: Any],
+                  let groups = entitlements["com.apple.security.application-groups"] as? [String] else { return [] }
+            return groups
+        }
+        
+        if let provURL = self.url(forResource: "embedded", withExtension: "mobileprovision") {
+            candidates.append(contentsOf: extractGroups(from: provURL))
+        }
+        let parentProvURL = self.bundleURL.deletingLastPathComponent().deletingLastPathComponent().appendingPathComponent("embedded.mobileprovision")
+        if FileManager.default.fileExists(atPath: parentProvURL.path) {
+            candidates.append(contentsOf: extractGroups(from: parentProvURL))
+        }
+        
+        // 2. Doc ALTAppGroups tu Info.plist
+        if let altGroups = self.object(forInfoDictionaryKey: "ALTAppGroups") as? [String] {
+            candidates.append(contentsOf: altGroups)
+        }
+        
+        // 3. Thu tao group tu bundleIdentifier
+        if let bundleID = self.bundleIdentifier {
+            candidates.append("group.\(bundleID)")
+            let parts = bundleID.split(separator: ".")
+            if parts.count > 2 {
+                let mainID = parts.dropLast().joined(separator: ".")
+                candidates.append("group.\(mainID)")
+            }
+        }
+        
+        // Loc trung lap
+        var unique: [String] = []
+        for c in candidates where !c.isEmpty && !unique.contains(c) {
+            unique.append(c)
+        }
+        
+        // Uu tien nhung group thuc su truy cap duoc (containerURL != nil)
+        let accessible = unique.filter { FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: $0) != nil }
+        if !accessible.isEmpty {
+            return accessible
+        }
+        
+        return unique
     }
 }
