+    override func tableView(_ tableView: UITableView, trailingSwipeActionsConfigurationForRowAt indexPath: IndexPath) -> UISwipeActionsConfiguration?
+    {
+        let item = self.dataSource.item(at: indexPath)
+        let isPinned = item.isPinned
+        
+        let pinAction = UIContextualAction(style: .normal, title: isPinned ? "Bỏ ghim" : "Ghim") { [weak self] (action, view, completionHandler) in
+            item.isPinned.toggle()
+            self?.tableView.reloadRows(at: [indexPath], with: .automatic)
+            completionHandler(true)
+        }
+        pinAction.backgroundColor = isPinned ? .systemGray : .systemOrange
+        pinAction.image = UIImage(systemName: isPinned ? "pin.slash.fill" : "pin.fill")
+        
+        let deleteAction = UIContextualAction(style: .destructive, title: "Xoá") { (action, view, completionHandler) in
+            item.isMarkedForDeletion = true
+            completionHandler(true)
+        }
+        
+        return UISwipeActionsConfiguration(actions: [deleteAction, pinAction])
+    }
+
 }
diff --git a/ClipKit/Database/Model/PasteboardItem.swift b/ClipKit/Database/Model/PasteboardItem.swift
index b9c00b9..bad6a58 100644
--- a/ClipKit/Database/Model/PasteboardItem.swift
+++ b/ClipKit/Database/Model/PasteboardItem.swift
@@ -128,3 +128,35 @@ extension PasteboardItem
         return pasteboardItem
     }
 }
+
+
+public extension PasteboardItem
+{
+    var pinIdentifier: String {
+        if let string = self.preferredRepresentation?.stringValue {
+            return "text:" + string
+        }
+        if let data = self.preferredRepresentation?.data {
+            return "data:\(data.count):\(self.date.timeIntervalSinceReferenceDate)"
+        }
+        return self.objectID.uriRepresentation().absoluteString
+    }
+    
+    var isPinned: Bool {
+        get {
+            let pinned = UserDefaults.shared.stringArray(forKey: "ClipKit.PinnedItems") ?? []
+            return pinned.contains(self.pinIdentifier)
+        }
+        set {
+            var pinned = UserDefaults.shared.stringArray(forKey: "ClipKit.PinnedItems") ?? []
+            if newValue {
+                if !pinned.contains(self.pinIdentifier) {
+                    pinned.append(self.pinIdentifier)
+                }
+            } else {
+                pinned.removeAll { $0 == self.pinIdentifier }
+            }
+            UserDefaults.shared.set(pinned, forKey: "ClipKit.PinnedItems")
+        }
+    }
+}
